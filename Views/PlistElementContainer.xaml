<UserControl
    x:Class="PlistExplorer.Views.PlistElementContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PlistExplorer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:PlistExplorer.Models"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    Focusable="True"
    PreviewMouseLeftButtonDown="OnContainerPreviewMouseLeftButtonDown"
    PreviewMouseRightButtonDown="OnContainerPreviewMouseRightButtonDown"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="C"
            Command="{Binding CopySelectedElementsCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="V"
            Command="{Binding PasteElementsCommand}"
            Modifiers="Control" />
    </UserControl.InputBindings>

    <UserControl.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem Header="New">
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="Dict"
                    Header="Dict" />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="Array"
                    Header="Array" />
                <Separator />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="Boolean"
                    Header="Boolean" />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="Data"
                    Header="Data" />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="Date"
                    Header="Date" />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="Number"
                    Header="Number" />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="UID"
                    Header="UID" />
                <MenuItem
                    Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    CommandParameter="String"
                    Header="String" />
            </MenuItem>
            <MenuItem
                x:Name="PasteMenuItem"
                Command="{Binding PlacementTarget.DataContext.PasteElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Header="Paste"
                Visibility="{Binding PlacementTarget.DataContext.CanPasteElements, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <DockPanel Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
        <ScrollViewer>
            <ItemsControl HorizontalAlignment="Stretch" ItemsSource="{Binding LoadedElements}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <!--  Default: tiles elements horizontally and wraps them automatically  -->
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:PlistElementView Margin="4" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:PlistViewMode.List}">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel IsItemsHost="True" Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <local:PlistElementListItemView Margin="2" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
