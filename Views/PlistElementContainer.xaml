<UserControl x:Class="PlistExplorer.Views.PlistElementContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlistExplorer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             PreviewMouseRightButtonDown="OnContainerPreviewMouseRightButtonDown">
    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedElementsCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteElementsCommand}" />
    </UserControl.InputBindings>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Paste" Command="{Binding PlacementTarget.DataContext.PasteElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding LoadedElements}" HorizontalAlignment="Stretch">
                <!-- Tiles elements horizontally and wraps them automatically -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:PlistElementView Margin="4" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
