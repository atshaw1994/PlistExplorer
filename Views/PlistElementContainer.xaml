<UserControl x:Class="PlistExplorer.Views.PlistElementContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlistExplorer.Views"
             xmlns:models="clr-namespace:PlistExplorer.Models"
             mc:Ignorable="d" 
             Background="Transparent"
             Focusable="True"
             d:DesignHeight="450" d:DesignWidth="800"
             PreviewMouseLeftButtonDown="OnContainerPreviewMouseLeftButtonDown"
             PreviewMouseRightButtonDown="OnContainerPreviewMouseRightButtonDown">
    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedElementsCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteElementsCommand}" />
    </UserControl.InputBindings>

    <UserControl.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem Header="New">
                <MenuItem Header="Dict" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="Dict"/>
                <MenuItem Header="Array" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="Array"/>
                <Separator/>
                <MenuItem Header="Boolean" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="Boolean"/>
                <MenuItem Header="Data" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="Data"/>
                <MenuItem Header="Date" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="Date"/>
                <MenuItem Header="Number" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="Number"/>
                <MenuItem Header="UID" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="UID"/>
                <MenuItem Header="String" Command="{Binding PlacementTarget.DataContext.AddNewElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="String"/>
            </MenuItem>
            <MenuItem x:Name="PasteMenuItem" Header="Paste" 
                      Command="{Binding PlacementTarget.DataContext.PasteElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanPasteElements, RelativeSource={RelativeSource AncestorType=ContextMenu}, 
                        Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <DockPanel Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding LoadedElements}" HorizontalAlignment="Stretch">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <!-- Default: tiles elements horizontally and wraps them automatically -->
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:PlistElementView Margin="4" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:PlistViewMode.List}">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <local:PlistElementListItemView Margin="2" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
