<Window
    x:Class="PlistExplorer.Views.EditPlistElementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:models="clr-namespace:PlistExplorer.Models"
    Title="{Binding TargetElement.ElementName, StringFormat='Editing {0}'}"
    Width="520"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Properties List  -->
        <DataGrid
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding Properties}"
            SelectedItem="{Binding SelectedProperty}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding ElementName}"
                    Header="Key">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding ElementType}"
                    Header="Type"
                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="*" Header="Value">
                    <!--  Read-Only Preview  -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Text="{Binding ElementValue}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <!--  Native Type Editors  -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <!--  Standard String/Number Editor  -->
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBox
                                                        VerticalAlignment="Center"
                                                        FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                                        Text="{Binding ElementValue, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>
                                            <!--  Native Boolean Editor  -->
                                            <DataTrigger Binding="{Binding ElementType}" Value="Boolean">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <CheckBox
                                                                Margin="4,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <!--  Hex / Data Editor  -->
                                            <DataTrigger Binding="{Binding ElementType}" Value="Data">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBox
                                                                VerticalAlignment="Center"
                                                                FontFamily="Consolas"
                                                                Text="{Binding HexValue, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1">
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,4,0,0"
                Padding="35,6"
                HorizontalAlignment="Right"
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="Save" />
        </Grid>
    </Grid>
</Window>
