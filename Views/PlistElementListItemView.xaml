<UserControl
    x:Class="PlistExplorer.Views.PlistElementListItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:PlistExplorer.Helpers"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:local="clr-namespace:PlistExplorer.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PlistExplorer.Viewmodels"
    Height="32"
    HorizontalAlignment="Stretch"
    d:DataContext="{d:DesignInstance Type=vm:PlistElementViewModel,
                                     IsDesignTimeCreatable=True}"
    PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
    ToolTip="{Binding DisplayName}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:ElementTypeToIconConverter x:Key="ElementTypeToIconConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <MouseBinding Command="{Binding ToggleSelectCommand}" MouseAction="LeftClick" />
        <MouseBinding
            Command="{Binding DataContext.OpenElementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            MouseAction="LeftDoubleClick" />
    </UserControl.InputBindings>

    <UserControl.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem
                Command="{Binding PlacementTarget.Tag.EditElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Header="Edit" />
            <MenuItem Command="{Binding PlacementTarget.Tag.CopySelectedElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Copy" />
            <MenuItem
                x:Name="PasteMenuItem"
                Command="{Binding PlacementTarget.Tag.PasteElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Header="Paste"
                Visibility="{Binding PlacementTarget.Tag.CanPasteElements, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Separator />
            <MenuItem
                Command="{Binding PlacementTarget.Tag.DeleteElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Header="Delete" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <!--  Row styled with rounded corners and hover visual cues  -->
    <Border
        x:Name="RowBorder"
        Padding="6,2"
        BorderThickness="1"
        CornerRadius="4">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    </Trigger>

                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ic:SymbolIcon
                Margin="4,0"
                VerticalAlignment="Center"
                FontSize="18"
                Symbol="{Binding ElementType, Converter={StaticResource ElementTypeToIconConverter}}" />

            <TextBlock
                Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="Center"
                Text="{Binding DisplayName}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Column="2"
                Margin="4,0"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="{Binding ElementType}" />

            <TextBlock
                Grid.Column="3"
                Margin="4,0"
                VerticalAlignment="Center"
                FontSize="11"
                Text="{Binding ElementValue}" />
        </Grid>
    </Border>
</UserControl>
