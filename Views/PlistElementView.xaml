<UserControl x:Class="PlistExplorer.Views.PlistElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlistExplorer.Views"
             xmlns:vm="clr-namespace:PlistExplorer.Viewmodels"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:helpers="clr-namespace:PlistExplorer.Helpers"
             xmlns:models="clr-namespace:PlistExplorer.Models"
             mc:Ignorable="d" 
             ToolTip="{Binding DisplayName}"
             Height="128" Width="96"
             d:DataContext="{d:DesignInstance Type=vm:PlistElementViewModel, IsDesignTimeCreatable=True}"
             PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">

    <UserControl.Resources>
        <helpers:ElementTypeToIconConverter x:Key="ElementTypeToIconConverter"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSelectCommand}" />
        <MouseBinding MouseAction="LeftDoubleClick" 
                      Command="{Binding DataContext.OpenElementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" />
    </UserControl.InputBindings>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Copy" 
                  Command="{Binding PlacementTarget.Tag.CopySelectedElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Paste" 
                  Command="{Binding PlacementTarget.Tag.PasteElementsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Delete" 
                  Command="{Binding PlacementTarget.Tag.DeleteElementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <!-- Outer container styled with rounded corners and hover visual cues -->
    <Border x:Name="TileBorder" 
            CornerRadius="6" 
            Padding="6"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Set default values inside Style Setters instead of directly on Border -->
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>

                <Style.Triggers>
                    <!-- Mouse Hover Effect for Border -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Trigger>

                    <!-- Selection Effect (Overrides Hover) -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Large Folder/File Icon -->
            <ic:SymbolIcon Symbol="{Binding ElementType, Converter={StaticResource ElementTypeToIconConverter}}" 
                           FontSize="40"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                <ic:SymbolIcon.Style>
                    <Style TargetType="{x:Type ic:SymbolIcon}">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="0" CenterX="20" CenterY="20"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFalseBoolean}" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="20" CenterY="20"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ic:SymbolIcon.Style>
            </ic:SymbolIcon>

            <!-- Element Key / Name -->
            <TextBlock Text="{Binding DisplayName}" 
                       Grid.Row="1" 
                       Margin="0,4,0,0"
                       FontSize="12"
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
